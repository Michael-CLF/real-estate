        "disclosures.leadInspectionDays": 10,
        "documentVersions.lead-based-paint": {
          "$unset": true
        }
      },
      "hiddenFields": [
        "disclosures.leadPaintStatus",
        "disclosures.leadInspectionSelection",
        "disclosures.leadInspectionDays"
      ]
    }
  }
}
